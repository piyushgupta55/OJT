generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  organization String   @default("K3 Studio")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id                          String              @id @default(cuid())
  fullName                    String
  rollNumber                  String              @unique
  division                    String
  college                     String
  branch                      String
  email                       String              @unique
  phoneNumber                 String
  avatar                      String?
  startDate                   DateTime            @default(now())
  endDate                     DateTime
  durationDays                Int                 @default(30)
  ojtStatus                   String              @default("ONGOING")
  codingVideosCompleted       Boolean             @default(false)
  clientCommunicationTraining Boolean             @default(false)
  freelancingTraining         Boolean             @default(false)
  projectManagementTraining   Boolean             @default(false)
  finalProjectStatus          String              @default("IN_PROGRESS")
  certificateSent             Boolean             @default(false)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  activityLogs                ActivityLog[]
  assignments                 Assignment[]
  attendanceRecords           AttendanceRecord[]
  documents                   Document[]
  freelancerTracking          FreelancerTracking?
  project                     Project?
}

model FreelancerTracking {
  id             String   @id @default(cuid())
  studentId      String   @unique
  profileUrl     String?
  accountCreated Boolean  @default(false)
  planType       String   @default("FREE")
  bidsCompleted  Int      @default(0)
  targetBids     Int      @default(100)
  taskStatus     String   @default("NOT_STARTED")
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String    @id @default(cuid())
  studentId            String    @unique
  projectName          String
  description          String?
  sourcePlaylist       String?
  technologyUsed       String
  status               String    @default("IN_PROGRESS")
  githubUrl            String?
  liveDemoUrl          String?
  projectSubmittedDate DateTime?
  verificationStatus   String    @default("PENDING")
  verificationRemarks  String?
  verifiedAt           DateTime?
  verifiedBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  student              Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  studentId     String
  sessionNumber Int
  date          DateTime
  topic         String
  status        String   @default("PRESENT")
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionNumber])
}

model Assignment {
  id                 String    @id @default(cuid())
  studentId          String
  name               String
  description        String?
  dueDate            DateTime
  submittedDate      DateTime?
  submissionLink     String?
  status             String    @default("PENDING")
  verificationStatus String    @default("PENDING")
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Document {
  id             String    @id @default(cuid())
  studentId      String
  type           String
  title          String
  status         String    @default("NOT_ISSUED")
  issuedDate     DateTime?
  documentNumber String?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(cuid())
  studentId   String?
  action      String
  adminName   String   @default("Piyush Gupta")
  description String
  createdAt   DateTime @default(now())
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
